# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5001
CLIENT_URL=http://localhost:3013

# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=your_database

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret

# ─── Storage Provider ──────────────────────────────────────────────────────────
# Set this to switch storage backends. Options:
#   local       → store files on the server's local disk (default, no dependencies)
#   cloudinary  → Cloudinary CDN (requires: npm install cloudinary)
#   s3          → AWS S3         (requires: npm install @aws-sdk/client-s3)
#   spaces      → DigitalOcean Spaces (same S3 API, requires @aws-sdk/client-s3)
#   gcs         → Google Cloud Storage (requires: npm install @google-cloud/storage)
STORAGE_PROVIDER=local

# Base URL of your server (used to build public URLs for local storage)
# In production, this should be your domain: https://api.yourdomain.com
BASE_URL=http://localhost:5001

# ─── Cloudinary (STORAGE_PROVIDER=cloudinary) ─────────────────────────────────
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# ─── AWS S3 (STORAGE_PROVIDER=s3) ─────────────────────────────────────────────
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY=AKIAXXXXXXXXXXXXXXXX
# S3_SECRET_KEY=your+secret+key
# S3_CDN_BASE=https://d123abc.cloudfront.net   # optional CDN URL (e.g. CloudFront)

# ─── DigitalOcean Spaces (STORAGE_PROVIDER=spaces) ────────────────────────────
# Same keys as S3, plus the endpoint:
# S3_BUCKET=your-space-name
# S3_REGION=nyc3
# S3_ACCESS_KEY=your_spaces_key
# S3_SECRET_KEY=your_spaces_secret
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
# S3_CDN_BASE=https://your-space.nyc3.cdn.digitaloceanspaces.com  # optional

# ─── Google Cloud Storage (STORAGE_PROVIDER=gcs) ──────────────────────────────
# GCS_BUCKET=your-gcs-bucket
# GCS_PROJECT_ID=your-gcp-project-id
# GCS_KEY_FILE=/absolute/path/to/service-account-key.json
# OR instead of a file:
# GCS_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}
